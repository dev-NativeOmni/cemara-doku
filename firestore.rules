rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function for user authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function for household membership
    function isHouseholdMember(householdId) {
      return isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberUids;
    }

    // A non-member adding only themselves to memberUids (joining via invite code).
    // The household ID is only discoverable through inviteCodes/{code}.
    function isSelfJoin() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
        && request.resource.data.memberUids.hasAll(resource.data.memberUids)
        && request.auth.uid in request.resource.data.memberUids;
    }

    // User Profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Invite code -> householdId index. Readable only by exact code (no listing).
    match /inviteCodes/{code} {
      allow get: if isAuthenticated();
      allow create: if isHouseholdMember(request.resource.data.householdId)
        && get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.inviteCode == code;
    }

    // Household document
    match /households/{householdId} {
      allow create: if isAuthenticated() && request.resource.data.memberUids == [request.auth.uid];
      allow read: if isAuthenticated() && request.auth.uid in resource.data.memberUids;
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.memberUids || isSelfJoin()
      );

      // Sub-collections under Household
      match /{allChildren=**} {
        allow read, write: if isHouseholdMember(householdId);
      }
    }
  }
}
